{
  "name": "devslot-probe",
  "networks": {
    "default": {
      "name": "devslot-probe_default",
      "ipam": {}
    }
  },
  "services": {
    "app": {
      "restart": "always",
      "command": null,
      "entrypoint": null,
      "environment": {
        "DB_HOST": "postgres",
        "HOST": "0.0.0.0",
        "NODE_ENV": "production"
      },
      "env_file": [
        {
          "path": "__ROOT__/.env"
        }
      ],
      "networks": {
        "default": null
      },
      "build": {
        "context": "__ROOT__",
        "dockerfile": "Dockerfile"
      },
      "depends_on": {
        "postgres": {
          "condition": "service_healthy",
          "required": true
        }
      },
      "ports": [
        {
          "mode": "ingress",
          "target": 3333,
          "published": "61001",
          "protocol": "tcp"
        }
      ]
    },
    "postgres": {
      "restart": "always",
      "command": null,
      "entrypoint": null,
      "environment": {
        "POSTGRES_DB": "",
        "POSTGRES_PASSWORD": "",
        "POSTGRES_USER": ""
      },
      "image": "postgres:18",
      "networks": {
        "default": null
      },
      "volumes": [
        {
          "type": "volume",
          "source": "postgres-volume",
          "target": "/var/lib/postgresql",
          "volume": {}
        }
      ],
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "pg_isready",
          "-U",
          "",
          "-d",
          ""
        ],
        "timeout": "5s",
        "interval": "30s",
        "retries": 10,
        "start_period": "10s",
        "start_interval": "500ms"
      },
      "ports": [
        {
          "mode": "ingress",
          "target": 5432,
          "published": "61000",
          "protocol": "tcp"
        }
      ]
    }
  },
  "volumes": {
    "postgres-volume": {
      "name": "devslot-probe_postgres-volume"
    }
  }
}