{
  "name": "devslot-probe",
  "networks": {
    "default": {
      "name": "devslot-probe_default",
      "ipam": {}
    }
  },
  "services": {
    "mailpit": {
      "command": null,
      "entrypoint": null,
      "image": "axllent/mailpit:latest",
      "networks": {
        "default": null
      },
      "ports": [
        {
          "mode": "ingress",
          "target": 1025,
          "published": "1025",
          "protocol": "tcp"
        },
        {
          "mode": "ingress",
          "target": 8025,
          "published": "8025",
          "protocol": "tcp"
        }
      ]
    },
    "postgres": {
      "restart": "always",
      "command": null,
      "entrypoint": null,
      "environment": {
        "POSTGRES_DB": "",
        "POSTGRES_PASSWORD": "",
        "POSTGRES_USER": ""
      },
      "image": "postgres:18",
      "networks": {
        "default": null
      },
      "volumes": [
        {
          "type": "volume",
          "source": "postgres-volume",
          "target": "/var/lib/postgresql",
          "volume": {}
        }
      ],
      "ports": [
        {
          "mode": "ingress",
          "host_ip": "127.0.0.1",
          "target": 5432,
          "published": "61000",
          "protocol": "tcp"
        }
      ]
    }
  },
  "volumes": {
    "postgres-volume": {
      "name": "devslot-probe_postgres-volume"
    }
  }
}