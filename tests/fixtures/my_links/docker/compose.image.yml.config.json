{
  "name": "devslot-probe",
  "networks": {
    "default": {
      "name": "devslot-probe_default",
      "ipam": {}
    }
  },
  "services": {
    "my-links": {
      "restart": "always",
      "container_name": "my-links",
      "command": null,
      "entrypoint": null,
      "environment": {
        "DB_HOST": "postgres",
        "DB_PORT": "5432",
        "HOST": "0.0.0.0",
        "PORT": "3333"
      },
      "env_file": [
        {
          "path": "__ROOT__/.env"
        }
      ],
      "image": "example/my-links:latest",
      "networks": {
        "default": null
      },
      "ports": [
        {
          "mode": "ingress",
          "target": 3333,
          "published": "61001",
          "protocol": "tcp"
        }
      ]
    },
    "postgres": {
      "restart": "always",
      "command": null,
      "entrypoint": null,
      "environment": {
        "POSTGRES_DB": "",
        "POSTGRES_PASSWORD": "",
        "POSTGRES_USER": ""
      },
      "image": "postgres:18",
      "networks": {
        "default": null
      },
      "volumes": [
        {
          "type": "volume",
          "source": "postgres-volume",
          "target": "/var/lib/postgresql",
          "volume": {}
        }
      ],
      "ports": [
        {
          "mode": "ingress",
          "host_ip": "127.0.0.1",
          "target": 5432,
          "published": "61000",
          "protocol": "tcp"
        }
      ]
    }
  },
  "volumes": {
    "postgres-volume": {
      "name": "devslot-probe_postgres-volume"
    }
  }
}